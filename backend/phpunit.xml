<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AUU+Ug/6xHyFnMUfp04FDiCSW+bXz7sr0rS3XZO6OTM="/>
        <env name="APP_URL" value="http://localhost"/>
        <!-- MongoDB Atlas is the application database. The suite runs against
             the same cluster as production but a SEPARATE database
             (MONGODB_TEST_DATABASE), so RefreshDatabase can wipe collections
             without touching real data. MONGODB_URI / MONGODB_PASSWORD are
             supplied by the server-side .env — never hardcoded here; PHPUnit
             only overrides the values below, and an .env-provided URI wins
             because config/database.php reads it first. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="permetheon_test"/>
        <env name="MONGODB_DATABASE" value="permetheon_test"/>
        <!-- Persistent cache: the rate limiters are only real when counters
             survive across requests (a per-request array store silently
             disables every limit — see docs/SECURITY_FINDINGS_CARRYOVER.md). -->
        <env name="CACHE_STORE" value="database"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="INQUIRY_RATE_LIMIT_MAX" value="5"/>
        <env name="ADMIN_BOOTSTRAP_EMAIL" value="admin@permetheon.com"/>
        <!-- Feature tests send requests from 127.0.0.1, which is declared a
             trusted proxy here so tests can exercise BOTH rate-limit keying
             modes: forwarded-key tests (X-Forwarded-For set) and socket-key
             tests (no header). -->
        <env name="TRUSTED_PROXIES" value="127.0.0.1"/>
    </php>
</phpunit>
