# PERMETHEON V3 — BACKEND ENVIRONMENT (MySQL/MariaDB)
# Copy to .env, then: php artisan key:generate
# The application database is MySQL/MariaDB ONLY — SQLite is not supported.

APP_NAME=Permetheon
APP_ENV=local
APP_KEY=
# APP_DEBUG must be false in any shared or production environment.
APP_DEBUG=true
APP_URL=http://localhost:8000
# The APP_URL SCHEME also drives the `Secure` flag on the admin auth cookies
# when the request itself arrives over plain HTTP (e.g. TLS terminated on a
# load balancer): set APP_URL=https://… in any HTTPS deployment so the session
# cookie is marked Secure even if the app is reached over HTTP internally
# (docs/ADMIN_AUTH_REVIEW.md, finding F2).

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------- database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=permetheon
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------- cache / queue / session
# CACHE_STORE=database is REQUIRED for the rate limiters to work across
# requests — a per-request array store silently disables every limit
# (docs/SECURITY_FINDINGS_CARRYOVER.md, finding 1).
CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ------------------------------------------------------------ admin + limits
# First successful login with these credentials mints the initial SUPER_ADMIN
# and permanently wipes the password (it can never mint a second account).
# Leave unset until you are ready to create the first admin, then log in once.
ADMIN_BOOTSTRAP_EMAIL=admin@permetheon.com
# ADMIN_BOOTSTRAP_PASSWORD=

# Public inquiry submissions per 10 minutes per IP.
INQUIRY_RATE_LIMIT_MAX=5

# Rate-limit client key (the public inquiry AND admin login limiters share
# this rule). EMPTY (the default) means the raw socket peer is always the
# key — a client cannot spoof X-Forwarded-For to rotate its own bucket.
# ONLY set this when a real reverse proxy sits in front of the app;
# otherwise leave it unset.
#
# Behind a reverse proxy (nginx, Hostinger load balancer, Cloudflare) every
# request arrives from the proxy's IP, so without this BOTH rate limiters
# collapse into one shared bucket: 5 form submissions then break the contact
# form globally, and one attacker can lock out all admin logins
# (docs/ADMIN_AUTH_REVIEW.md, finding F1). Set it to the proxy's addresses
# (IPs or IPv4 CIDRs, comma-separated):
#   TRUSTED_PROXIES=10.0.0.0/8,173.245.48.0/20
# When a request arrives from a listed proxy, the key is the RIGHTMOST
# X-Forwarded-For entry on it — configure your outermost proxy so that entry
# is the real client address (the standard single-hop setup; for multi-hop,
# have the last hop forward the original client address rightmost). Verify
# after deploy: a burst of form posts must throttle per client, not app-wide.
# TRUSTED_PROXIES=

# Inquiry deletion policy: 'delete_meeting' (default) | 'prevent'
MEETING_INQUIRY_DELETE_POLICY=delete_meeting

# Retention (days) for dead admin sessions (revoked or absolutely expired).
# `admin:prune-sessions` runs daily via the scheduler and deletes rows that
# died more than this many days ago; live sessions are never touched
# (docs/ADMIN_AUTH_REVIEW.md, finding F8). Requires `php artisan
# schedule:work` (or a cron'd `schedule:run`) in production.
SESSIONS_PRUNE_DAYS=30

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
